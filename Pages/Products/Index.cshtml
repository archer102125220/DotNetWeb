@page
@model DotNetWeb.Pages.Products.IndexModel
@{
    // 設定網頁標題
    ViewData["Title"] = "產品列表";
}

<h1>產品列表 (CRUD 範例)</h1>

<p>
    <!-- 導向 Create 頁面的按鈕 -->
    <a asp-page="Create" class="btn btn-primary">新增產品</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>產品 ID</th>
            <th>產品名稱</th>
            <th>產品價格</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        <!-- 迴圈顯示後端傳來的 Products 資料 -->
        @foreach (var item in Model.Products)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>
                    <!-- 導向其他頁面並帶上 id 參數 -->
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">編輯 (Edit)</a> |
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">詳細 (Details)</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">刪除 (Delete)</a>
                </td>
            </tr>
        }
    </tbody>
</table>
