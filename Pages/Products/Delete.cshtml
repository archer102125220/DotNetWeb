@page "{id:int}"
@model DotNetWeb.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "刪除產品";
}

<h1>刪除產品 (Delete)</h1>

<h3>確定要刪除這筆資料嗎？</h3>
<div>
    <h4>產品</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Product.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Product.Name)
        </dd>
        
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Product.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Product.Price)
        </dd>
    </dl>
    
    <!-- 送出刪除請求的表單 -->
    <form method="post">
        <!-- 傳遞要刪除的產品 ID -->
        <input type="hidden" asp-for="Product.Id" />
        <input type="submit" value="確認刪除" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">返回列表</a>
    </form>
</div>
