@page
@model NotFoundModel
@{
    ViewData["Title"] = "404 找不到頁面";
}

<div class="text-center mt-5">
    <h1 class="display-1 fw-bold text-danger">404</h1>
    <h2 class="mb-4">找不到頁面</h2>
    <p class="lead mb-5">
        很抱歉，您所尋找的頁面不存在。它可能已被移除、重新命名，或是暫時無法使用。
    </p>
    <a href="/" class="btn btn-primary btn-lg">返回首頁</a>
</div>
